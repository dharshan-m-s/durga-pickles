import 'dotenv/config';
import express from 'express';
import multer from 'multer';
import crypto from 'node:crypto';
import fs from 'node:fs/promises';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const root = path.resolve(__dirname, '..');
const dataDir = path.join(__dirname, 'data');
const uploadsDir = path.join(__dirname, 'uploads');
const contentPath = path.join(dataDir, 'content.json');
const distDir = path.join(root, 'dist');

const app = express();
const sessions = new Map();
const loginAttempts = new Map();
const SESSION_TTL = 24 * 60 * 60 * 1000; // 24 hours
const PORT = Number(process.env.PORT || 8787);

// CSRF protection
function generateCSRFToken() {
  return crypto.randomBytes(32).toString('hex');
}
function getCSRFToken(req) {
  const session = sessions.get(parseCookies(req.headers.cookie).durga_cms);
  return session?.csrfToken;
}
function validateCSRFToken(req) {
  const token = req.headers['x-csrf-token'] || req.body?.csrfToken;
  const expected = getCSRFToken(req);
  return token && expected && crypto.timingSafeEqual(Buffer.from(token), Buffer.from(expected));
}

await fs.mkdir(dataDir, { recursive: true });
await fs.mkdir(uploadsDir, { recursive: true });

const defaultContent = {
  site: {
    brandName: 'Durga Foods', shortBrand: 'Durga Pickles', announcement: 'Durga Foods • Since 1996 • Pazhayannur, Thrissur, Kerala',
    heroEyebrow: 'DURGA FOODS • SINCE 1996', heroTitleLine1: 'Made for', heroTitleLine2: 'the table.',
    heroDescription: 'Explore the current Durga collection of pickles, kondattam and traditional food products.',
    heroMainImage: '/products/originals/collection-wide-1.jpg', homeCollectionImage: '/products/originals/collection-wide-2.jpg',
    footerDescription: 'Durga Pickles · Sree Durga Food Products', phone: '04884 225174', consumerCare: '90206 54578', whatsapp: '919020654578',
    locationLine1: 'Thekkethara, Pazhayannur', locationLine2: 'Thrissur, Kerala — 680 587',
    mapUrl: 'https://www.google.com/maps/search/?api=1&query=Thekkethara%20Pazhayannur%20Thrissur%20Kerala%20680587',
    metaTitle: 'Durga Foods — Since 1996', metaDescription: 'Durga Pickles — Sree Durga Food Products, Pazhayannur, Thrissur, Kerala. Since 1996.',
    marqueeItems: ['DURGA FOODS','SINCE 1996','PAZHAYANNUR · THRISSUR','TRADITIONAL FAVOURITES','SREE DURGA FOOD PRODUCTS'], featuredProductIds: []
  },
  products: [], gallery: []
};

async function readJson(file, fallback) {
  try { return JSON.parse(await fs.readFile(file, 'utf8')); } catch { return fallback; }
}
async function writeJson(file, value) {
  const tmp = `${file}.tmp`;
  await fs.writeFile(tmp, JSON.stringify(value, null, 2), 'utf8');
  await fs.rename(tmp, file);
}
async function readContent() {
  const value = await readJson(contentPath, defaultContent);
  return normaliseContent(value);
}
const adminPassword = String(process.env.ADMIN_PASSWORD || '');
const usableAdminPassword = adminPassword && !/^replace-with-/i.test(adminPassword) && adminPassword.length >= 12 ? adminPassword : '';
const adminPasswordDigest = usableAdminPassword ? crypto.createHash('sha256').update(usableAdminPassword).digest() : null;
function passwordMatches(candidate) {
  if (!adminPasswordDigest) return false;
  const candidateDigest = crypto.createHash('sha256').update(String(candidate || '')).digest();
  return crypto.timingSafeEqual(candidateDigest, adminPasswordDigest);
}
function makeToken() { return crypto.randomBytes(32).toString('hex'); }
function parseCookies(header='') {
  return Object.fromEntries(header.split(';').map(p => p.trim().split('=')) .filter(([k,v]) => k && v));
}
function setSession(res, token) { const secure = process.env.NODE_ENV === 'production' ? '; Secure' : ''; res.setHeader('Set-Cookie', `durga_cms=${token}; HttpOnly; SameSite=Lax; Path=/; Max-Age=604800${secure}`); }
function clearSession(res) { res.setHeader('Set-Cookie', 'durga_cms=; HttpOnly; SameSite=Lax; Path=/; Max-Age=0'); }
function authed(req) { const token = parseCookies(req.headers.cookie).durga_cms; const created = token && sessions.get(token); if (!created) return false; if (Date.now() - created > SESSION_TTL) { sessions.delete(token); return false; } return true; }
function requireAuth(req, res, next) { if (!authed(req)) return res.status(401).json({ error: 'Authentication required' }); next(); }
function slugify(value) { return String(value || 'product').toLowerCase().trim().replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'') || `item-${Date.now()}`; }
function safeId(value, fallback='item') { const id = slugify(value); return id || `${fallback}-${Date.now()}`; }
function cleanFileName(name) { return String(name || '').replace(/[^a-zA-Z0-9._-]/g, '-').slice(-120); }
function clientKey(req) { return req.ip || req.socket?.remoteAddress || 'unknown'; }
function rateLimited(req, limit=8, windowMs=10*60*1000) { const now=Date.now(); const key=clientKey(req); const hits=(loginAttempts.get(key)||[]).filter(t=>now-t<windowMs); loginAttempts.set(key,hits); return hits.length>=limit; }
function recordFailedAttempt(req, windowMs=10*60*1000) { const now=Date.now(); const key=clientKey(req); const hits=(loginAttempts.get(key)||[]).filter(t=>now-t<windowMs); hits.push(now); loginAttempts.set(key,hits); }
function clearFailedAttempts(req) { loginAttempts.delete(clientKey(req)); }
function validMoney(value) { return value === '' || value === null || value === undefined || /^\d+(\.\d{1,2})?$/.test(String(value).trim()); }
function normaliseContent(payload) {
  const site={...defaultContent.site,...(payload?.site||{})};
  site.featuredProductIds=Array.isArray(site.featuredProductIds)?site.featuredProductIds.map(String):[];
  site.marqueeItems=Array.isArray(site.marqueeItems)?site.marqueeItems.map(v=>String(v).trim()).filter(Boolean):[];
  const products=Array.isArray(payload?.products)?payload.products.map((p,i)=>({
    id:safeId(p?.id||p?.name||`product-${i+1}`), name:String(p?.name||'Untitled Product').trim(), category:String(p?.category||'Pickles').trim(), size:String(p?.size||'').trim(),
    price:validMoney(p?.price)?String(p?.price??'').trim():'', mrp:validMoney(p?.mrp)?String(p?.mrp??'').trim():'', image:String(p?.image||''), description:String(p?.description||''),
    featured:Boolean(p?.featured), order:Number.isFinite(Number(p?.order))?Number(p.order):i
  })):[];
  const ids=new Set(); products.forEach((p,i)=>{let id=p.id,c=2;while(ids.has(id))id=`${p.id}-${c++}`;p.id=id;ids.add(id);});
  site.featuredProductIds=site.featuredProductIds.filter(id=>ids.has(id));
  const gallery=Array.isArray(payload?.gallery)?payload.gallery.map((g,i)=>({id:safeId(g?.id||`gallery-${i+1}`),src:String(g?.src||''),label:String(g?.label||'Untitled').trim(),type:g?.type==='wide'?'wide':'portrait',order:Number.isFinite(Number(g?.order))?Number(g.order):i})):[];
  return {site,products,gallery};
}

const storage = multer.diskStorage({
  destination: (_, __, cb) => cb(null, uploadsDir),
  filename: (_, file, cb) => cb(null, `${Date.now()}-${crypto.randomBytes(5).toString('hex')}-${cleanFileName(file.originalname)}`)
});
const upload = multer({ storage, limits: { fileSize: 20 * 1024 * 1024 }, fileFilter: (_, file, cb) => cb(null, /^image\//.test(file.mimetype)) });

app.disable('x-powered-by');
app.set('trust proxy', process.env.TRUST_PROXY === 'true');
app.use((req,res,next)=>{
  res.setHeader('X-Content-Type-Options','nosniff');
  res.setHeader('Referrer-Policy','strict-origin-when-cross-origin');
  res.setHeader('X-Frame-Options','DENY');
  res.setHeader('Permissions-Policy','camera=(), microphone=(), geolocation=()');
  // Content Security Policy
  res.setHeader('Content-Security-Policy', "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'none';");

  // CSRF protection for state-changing operations
  if (!['GET', 'HEAD', 'OPTIONS'].includes(req.method) && req.path.startsWith('/api/')) {
    if (!validateCSRFToken(req)) {
      return res.status(403).json({ error: 'Invalid CSRF token' });
    }
  }

  next();
});
app.use((req,res,next)=>{ if(req.path.startsWith('/api/')) res.setHeader('Cache-Control','no-store'); next(); });
app.use(express.json({ limit: '12mb' }));
app.use('/uploads', express.static(uploadsDir, { maxAge: '1d', immutable: true }));

app.get('/api/auth/status', (_, res) => {
  res.json({ configured: Boolean(adminPasswordDigest), setupRequired: false, authenticated: false });
});
app.post('/api/auth/login', async (req, res) => {
  const password = String(req.body?.password || '');
  if (!adminPasswordDigest) return res.status(503).json({ error: 'Admin password is not configured. Set ADMIN_PASSWORD in .env and restart the server.' });
  if (rateLimited(req)) return res.status(429).json({ error: 'Too many attempts. Try again later.' });
  if (password.length < 1 || !passwordMatches(password)) { recordFailedAttempt(req); return res.status(401).json({ error: 'Incorrect password' }); }
  clearFailedAttempts(req);
  const token = makeToken();
  const csrfToken = generateCSRFToken();
  const sessionData = { created: Date.now(), csrfToken };
  sessions.set(token, sessionData);
  setSession(res, token);
  res.json({ ok: true, csrfToken });
});
app.post('/api/auth/logout', (req,res)=>{
  const token=parseCookies(req.headers.cookie).durga_cms;
  if(token) sessions.delete(token);
  clearSession(res);
  res.json({ ok:true });
});

app.get('/api/content', async (_, res) => res.json(await readContent()));
app.get('/api/admin/session', requireAuth, async (_, res) => res.json({ ok: true }));

app.put('/api/settings', requireAuth, async (req,res) => {
  const content = await readContent();
  const allowed = {};
  for (const key of Object.keys(defaultContent.site)) if (Object.prototype.hasOwnProperty.call(req.body || {}, key)) allowed[key] = req.body[key];
  const next = normaliseContent({ ...content, site: { ...content.site, ...allowed }, products: content.products, gallery: content.gallery });
  await writeJson(contentPath, next);
  res.json(next.site);
});

app.post('/api/upload', requireAuth, upload.single('file'), async (req,res) => {
  if (!req.file) return res.status(400).json({ error: 'Image file is required' });
  try {
    const head = await fs.readFile(req.file.path, { encoding: null });
    const ok = head.subarray(0,8).toString('hex').startsWith('89504e470d0a1a0a') || head.subarray(0,3).toString('hex') === 'ffd8ff' || head.subarray(0,6).toString('ascii') === 'GIF89a' || head.subarray(0,6).toString('ascii') === 'GIF87a' || (head.subarray(0,4).toString('ascii') === 'RIFF' && head.subarray(8,12).toString('ascii') === 'WEBP') || (head.subarray(4,12).toString('ascii') === 'ftypavif' || head.subarray(4,12).toString('ascii') === 'ftypavis');
    if (!ok) { await fs.unlink(req.file.path).catch(()=>{}); return res.status(400).json({ error: 'The uploaded file is not a supported image.' }); }
    res.json({ url: `/uploads/${req.file.filename}`, name: req.file.originalname, size: req.file.size });
  } catch { await fs.unlink(req.file.path).catch(()=>{}); res.status(400).json({ error: 'Could not verify the uploaded image.' }); }
});

app.post('/api/products', requireAuth, async (req,res) => {
  const content = await readContent();
  const body = req.body || {};
  if (!validMoney(body.price) || !validMoney(body.mrp)) return res.status(400).json({ error: 'Price and MRP must be numbers with up to two decimals.' });
  const requestedId = safeId(body.id || body.name || 'product');
  let id = requestedId;
  let counter = 2;
  while (content.products.some(p => p.id === id)) id = `${requestedId}-${counter++}`;
  const product = {
    id, name: String(body.name || 'Untitled Product'), category: String(body.category || 'Pickles'), size: String(body.size || ''),
    price: body.price ?? '', mrp: body.mrp ?? '', image: String(body.image || ''), description: String(body.description || ''),
    featured: Boolean(body.featured), order: Number.isFinite(Number(body.order)) ? Number(body.order) : content.products.length
  };
  content.products.push(product);
  if (product.featured && !content.site.featuredProductIds.includes(product.id)) content.site.featuredProductIds.push(product.id);
  await writeJson(contentPath, content); res.status(201).json(product);
});
app.put('/api/products/:id', requireAuth, async (req,res) => {
  const content = await readContent(); const index = content.products.findIndex(p => p.id === req.params.id);
  if (index < 0) return res.status(404).json({ error: 'Product not found' });
  const old = content.products[index]; const body = req.body || {};
  if (!validMoney(body.price ?? old.price) || !validMoney(body.mrp ?? old.mrp)) return res.status(400).json({ error: 'Price and MRP must be numbers with up to two decimals.' });
  const nextId = safeId(body.id || old.id);
  if (nextId !== old.id && content.products.some(p => p.id === nextId)) return res.status(409).json({ error: 'Another product uses that ID' });
  content.products[index] = { ...old, ...body, id: nextId, featured: Boolean(body.featured ?? old.featured), order: Number(body.order ?? old.order ?? index) };
  if (old.image && old.image !== content.products[index].image) await deleteManagedImage(old.image);
  content.site.featuredProductIds = content.site.featuredProductIds.map(id => id === old.id ? nextId : id);
  if (content.products[index].featured && !content.site.featuredProductIds.includes(nextId)) content.site.featuredProductIds.push(nextId);
  if (!content.products[index].featured) content.site.featuredProductIds = content.site.featuredProductIds.filter(id => id !== nextId);
  await writeJson(contentPath, content); res.json(content.products[index]);
});
async function deleteManagedImage(url) {
  if (!url || !String(url).startsWith('/uploads/')) return;
  try { await fs.unlink(path.join(uploadsDir, path.basename(url))); } catch (_) {}
}
app.delete('/api/products/:id', requireAuth, async (req,res) => {
  const content = await readContent(); const index = content.products.findIndex(p => p.id === req.params.id);
  if (index < 0) return res.status(404).json({ error: 'Product not found' });
  const [removed] = content.products.splice(index,1); content.site.featuredProductIds = content.site.featuredProductIds.filter(id => id !== removed.id);
  await deleteManagedImage(removed.image); await writeJson(contentPath, content); res.json({ ok:true });
});

app.post('/api/gallery', requireAuth, async (req,res) => {
  const content = await readContent(); const body=req.body || {};
  const item = { id: safeId(body.id || `${body.label || 'gallery'}-${Date.now()}`), src:String(body.src || ''), label:String(body.label || 'Untitled'), type:body.type==='wide'?'wide':'portrait', order:Number(body.order ?? content.gallery.length) };
  while (content.gallery.some(g=>g.id===item.id)) item.id += '-2'; content.gallery.push(item); await writeJson(contentPath,content); res.status(201).json(item);
});
app.put('/api/gallery/:id', requireAuth, async (req,res) => {
  const content=await readContent(); const index=content.gallery.findIndex(g=>g.id===req.params.id); if(index<0)return res.status(404).json({error:'Gallery item not found'});
  const old=content.gallery[index]; content.gallery[index]={...old,...req.body,id:old.id,type:req.body.type==='wide'?'wide':'portrait',order:Number(req.body.order ?? old.order ?? index)}; if (old.src && old.src !== content.gallery[index].src) await deleteManagedImage(old.src); await writeJson(contentPath,content); res.json(content.gallery[index]);
});
app.delete('/api/gallery/:id', requireAuth, async (req,res)=>{
  const content=await readContent(); const index=content.gallery.findIndex(g=>g.id===req.params.id); if(index<0)return res.status(404).json({error:'Gallery item not found'});
  const [removed]=content.gallery.splice(index,1); await deleteManagedImage(removed.src); await writeJson(contentPath,content); res.json({ok:true});
});

app.get('/api/export', requireAuth, async (_,res)=>{
  const content=await readContent(); res.setHeader('Content-Disposition','attachment; filename="durga-content-backup.json"'); res.json(content);
});
app.post('/api/import', requireAuth, async (req,res)=>{
  const payload=req.body;
  if(!payload || !payload.site || !Array.isArray(payload.products) || !Array.isArray(payload.gallery)) return res.status(400).json({error:'Invalid content backup'});
  const next = normaliseContent(payload);
  await writeJson(contentPath,next); res.json(next);
});

app.get(/.*/, async (req,res)=>{
  if (req.path.startsWith('/api/') || req.path.startsWith('/uploads/')) return res.status(404).end();
  try { await fs.access(path.join(distDir,'index.html')); return res.sendFile(path.join(distDir,'index.html')); }
  catch { res.status(503).send('Build the frontend first with npm run build.'); }
});

app.listen(PORT, ()=> console.log(`Durga Foods CMS server running on http://localhost:${PORT}`));
