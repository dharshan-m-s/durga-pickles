# Local development environment for Durga Foods CMS
# Never commit a real .env file.

# Required for the admin CMS. Use a long random password (12+ characters).
ADMIN_PASSWORD=replace-with-a-long-random-password

# Local Express only. Usually false.
TRUST_PROXY=false

# Production on Vercel: connect a Vercel Blob store to the project.
# Vercel supplies BLOB_READ_WRITE_TOKEN automatically to the connected project.
# Do not commit the token here.
